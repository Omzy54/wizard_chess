{
  "name": "wizard-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Wizard Chess, a turn-based wizard duel on an 8x8 grid.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arena": "node tools/arena.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Omer Tiryaki",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
